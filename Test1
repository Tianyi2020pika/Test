    // 生成测试习惯全年模拟打卡记录（2026年1月至今，今日完成 1/3）
    function generateTestHabitRecords() {
      const records = {};
      const now = new Date();
      const year = now.getFullYear();
      const todayStr = getDateStr(now);

      // 遍历今年1月1日到昨天，生成规律且自然的打卡记录
      const start = new Date(year, 0, 1);
      const cursor = new Date(start);
      let dayIndex = 0;

      while (cursor < now) {
        const dStr = getDateStr(cursor);
        if (dStr !== todayStr) {
          // 约 75% 的日子有打卡，部分达到 3/3 满额，部分为 1~2 次
          const seed = (dayIndex * 17 + cursor.getMonth() * 7 + cursor.getDate() * 3) % 10;
          if (seed < 5) {
            records[dStr] = 3;
          } else if (seed < 8) {
            records[dStr] = (seed % 2) + 1;
          }
        }
        cursor.setDate(cursor.getDate() + 1);
        dayIndex++;
      }

      // 今日默认完成 1/3，方便直观展示左侧 1/3 晴空蓝进度填充与右侧 "1" 打卡钮
      records[todayStr] = 1;
      return records;
    }

