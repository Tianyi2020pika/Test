    function handleCheckIn(habitId) {
      const habit = state.habits.find(h => h.id === habitId);
      if (!habit) return;

      const today = getDateStr();
      if (!habit.records) habit.records = {};
      const current = habit.records[today] || 0;
      const target = habit.dailyTarget || 1;

      // 达到目标后再次点击归零（方便测试 1 -> 2 -> 3(✓) -> 0 循环体验）
      let nextVal = current + 1;

      if (current >= target) {
        nextVal = 0;
        delete habit.records[today];
        showToast('已重置今日打卡次数');
      } else {
        habit.records[today] = nextVal;
        const nowTime = `${today} ${String(new Date().getHours()).padStart(2, '0')}:${String(new Date().getMinutes()).padStart(2, '0')}`;
